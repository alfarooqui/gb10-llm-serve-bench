# Profile: single DGX Spark / Dell Pro Max with GB10, 128 GB unified memory.
PROFILE_NAME=gb10-128g

# Open model, no license acceptance. Good baseline: fits easily, fast to load.
MODEL=mistralai/Mistral-7B-Instruct-v0.3

# GB10 memory is unified with the OS. Leave headroom.
GPU_MEM_UTIL=0.70
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=128

# Extra vllm serve flags. Keep empty for the baseline.
EXTRA_ARGS=

PORT=8000

# Benchmark settings (keep identical across platforms).
BENCH_LEVELS=1,2,4,8,16
BENCH_MAX_TOKENS=256
