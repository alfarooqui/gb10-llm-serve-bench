# Profile TEMPLATE: RTX PRO 6000 (96 GB VRAM). Fill in after the first run.
# Keep MODEL, MAX_MODEL_LEN, MAX_NUM_SEQS and BENCH_* identical to gb10-128g.env
# so the comparison is fair. Only GPU_MEM_UTIL and PROFILE_NAME should differ.
PROFILE_NAME=rtx-pro-6000-96g

MODEL=mistralai/Mistral-7B-Instruct-v0.3
GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=64
EXTRA_ARGS=
PORT=8000

BENCH_LEVELS=1,2,4,8,16
BENCH_MAX_TOKENS=256
